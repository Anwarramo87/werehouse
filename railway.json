{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "backend-nest/**",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "npx prisma migrate deploy",
    "restartPolicyType": "ON_FAILURE"
  }
}

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend-nest/Dockerfile",
    "watchPatterns": [
      "backend-nest/**",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "npx prisma migrate deploy",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

PORT="5001"
HOST="0.0.0.0"
NODE_ENV="development"
QUEUES_ENABLED="false"
CACHE_ENABLED="true"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="REPLACE_ME"
JWT_EXPIRE="15m"
JWT_COOKIE_NAME="warehouse_access_token"
JWT_COOKIE_SECURE="false"
JWT_COOKIE_SAME_SITE="lax"
# Leave empty unless the frontend and API share a registered domain.
JWT_COOKIE_DOMAIN=
JWT_COOKIE_MAX_AGE_MS="900000"
JWT_REFRESH_DAYS="7"
JWT_REFRESH_COOKIE_NAME="warehouse_refresh_token"
JWT_ROTATE_THRESHOLD_SEC="300"

AUTH_MAX_LOGIN_ATTEMPTS="5"
# Names bootstrap accounts whose password may be reset from this file on the
# next boot ("admin,superadmin" or "all"). Leave empty; set it for one deploy
# only, then remove it.
AUTH_FORCE_PASSWORD_RESET=
AUTH_LOCKOUT_MINUTES="15"
CSRF_PROTECTION_ENABLED="false"

ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@warehouse.local"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_ME"

DEV_ADMIN_USERNAME="developer"
DEV_ADMIN_EMAIL="developer@warehouse.local"
DEV_ADMIN_PASSWORD="REPLACE_ME"

SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_EMAIL="superadmin@warehouse.local"
SUPERADMIN_PASSWORD="REPLACE_ME"

# Neon / Postgres connection — rotate in Neon dashboard before use
DATABASE_URL="postgresql://user:REPLACE_ME@host:5432/database?sslmode=verify-full"

# Comma-separated frontend origins (required in production)
CORS_ORIGIN="http://localhost:3000,http://localhost:5001"

# Production: cookie-only auth (no Bearer header, no token in JSON body)
JWT_ALLOW_BEARER="true"
AUTH_RETURN_TOKEN_IN_BODY="true"
REGISTRATION_ENABLED="true"

# Required in production for kiosk/device attendance endpoints
DEVICE_API_KEY="REPLACE_ME"

# Set to false only for local dev without a device; default true (fail-closed)
DEVICE_AUTH_ENFORCED="true"

# Storage root for uploads. Leave empty in development (falls back to
# tmp/uploads); MUST be a mounted volume in production.
UPLOAD_ROOT=
APP_TIMEZONE_OFFSET_MINUTES="180"

TRUST_PROXY="false"
REDIS_URL="redis://127.0.0.1:6379"
TOKEN_REVOCATION_STRICT="false"
BCRYPT_ROUNDS="12"
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"
PRISMA_SLOW_QUERY_MS="800"

# ─── AI assistant ────────────────────────────────────────────────────────
# The assistant needs ONE provider credential. Without any of them the panel
# still appears but reports itself as unconfigured.
#
# ASSISTANT_PROVIDER pins the provider ("anthropic" | "gemini" | "groq").
# Leave it empty to auto-detect, which prefers Anthropic, then Groq, then Gemini.
ASSISTANT_PROVIDER="groq"

# Anthropic (Claude) — default model claude-opus-5
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Groq — default model openai/gpt-oss-120b
GROQ_API_KEY=""
GROQ_MODEL=""

# Google Gemini — default model gemini-2.5-flash
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Wall-clock budget for one assistant question, in ms (default 90000).
ASSISTANT_TIME_BUDGET_MS="90000"

# ── Backups ──────────────────────────────────────────────────────────────────
# Defaults to <UPLOAD_ROOT>/backups. A mounted volume survives redeploys but is
# NOT offsite: if the volume dies the backups die with the database. Copy them
# off the box on a schedule.
BACKUP_ROOT=""
BACKUP_RETENTION_DAYS="30"

# ── Processes ────────────────────────────────────────────────────────────────
# Unset or "1" = one process. "auto" = one worker per core. Each worker costs
# ~150MB; only the first registers @Cron schedules, so the hourly sweeps do not
# fire once per worker.
CLUSTER_WORKERS="auto"

# Per-client login limit, keyed on the forwarded client IP or the authenticated
# user — not on the shared proxy address.
AUTH_THROTTLE_LIMIT="10"

# ROLE selects what a container is: "api" (default) or "worker". Deploy this
# image a SECOND time with ROLE=worker, or payroll runs inline on the API event
# loop and blocks every other request for its duration.
# ROLE="api"

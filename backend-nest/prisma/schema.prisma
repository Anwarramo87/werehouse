generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                           User[]
  biometricCredentials            BiometricCredential[]
  employees                       Employee[]
  departments                     Department[]
  leaveRequests                   LeaveRequest[]
  devices                         Device[]
  attendanceRecords               AttendanceRecord[]
  dailyAttendanceLogs             DailyAttendanceLog[]
  products                        Product[]
  stockLevels                     StockLevel[]
  warehouses                      Warehouse[]
  stockMovements                  StockMovement[]
  suppliers                       Supplier[]
  purchaseOrders                  PurchaseOrder[]
  purchaseOrderItems              PurchaseOrderItem[]
  goodsReceipts                   GoodsReceipt[]
  goodsReceiptItems               GoodsReceiptItem[]
  customers                       Customer[]
  salesOrders                     SalesOrder[]
  salesOrderItems                 SalesOrderItem[]
  salesPayments                   SalesPayment[]
  accounts                        Account[]
  journalEntrys                   JournalEntry[]
  journalEntryLines               JournalEntryLine[]
  importJobs                      ImportJob[]
  payrollRuns                     PayrollRun[]
  payrollItems                    PayrollItem[]
  payrollReceipts                 PayrollReceipt[]
  payrollInputs                   PayrollInput[]
  employeeSalarys                 EmployeeSalary[]
  employeeAdvances                EmployeeAdvance[]
  deletedRecordHistorys           DeletedRecordHistory[]
  employeeInsurances              EmployeeInsurance[]
  employeeBonuss                  EmployeeBonus[]
  employeePenaltys                EmployeePenalty[]
  terminationRecords              TerminationRecord[]
  financialSettlements            FinancialSettlement[]
  rehireRecords                   RehireRecord[]
  buss                            Bus[]
  busPassengers                   BusPassenger[]
  auditLogs                       AuditLog[]
  notifications                   Notification[]
  productBatchs                   ProductBatch[]
  batchStockLevels                BatchStockLevel[]
  expiryAlertRules                ExpiryAlertRule[]
  warehouseZones                  WarehouseZone[]
  storageBins                     StorageBin[]
  putawayTasks                    PutawayTask[]
  taxRates                        TaxRate[]
  priceTiers                      PriceTier[]
  productPrices                   ProductPrice[]
  purchaseInvoices                PurchaseInvoice[]
  purchaseInvoiceItems            PurchaseInvoiceItem[]
  landedCosts                     LandedCost[]
  purchasePayments                PurchasePayment[]
  costHistorys                    CostHistory[]
  salesInvoices                   SalesInvoice[]
  salesInvoiceItems               SalesInvoiceItem[]
  deliveryNotes                   DeliveryNote[]
  deliveryNoteItems               DeliveryNoteItem[]
  cycleCounts                     CycleCount[]
  cycleCountItems                 CycleCountItem[]
  qualityInspections              QualityInspection[]
  pickLists                       PickList[]
  pickListItems                   PickListItem[]
  carriers                        Carrier[]
  shipments                       Shipment[]
  packages                        Package[]
  packageItems                    PackageItem[]
  integrationConnections          IntegrationConnection[]
  integrationSyncLogs             IntegrationSyncLog[]
  webhookEndpoints                WebhookEndpoint[]
  accountMappings                 AccountMapping[]
  entitlement                     TenantEntitlement?

  @@index([status])
  @@map("tenants")
}

/**
 * Which pages a factory has been sold.
 *
 * One row per factory rather than one row per page: this is read on every
 * gated request, so a single indexed lookup that can be cached whole beats a
 * join returning dozens of rows. Modules are not stored -- they are a bundle
 * operation over these page keys, so there is never a "module on, page off"
 * contradiction to resolve. See src/common/entitlements/catalogue.ts.
 */
model TenantEntitlement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Page keys from the catalogue. Absent key = not entitled.
  enabledPages String[] @default([])

  /// Who last changed this, for the audit trail the Super Admin UI writes.
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_entitlements")
}


model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  permissions String[]   @default([])
  users       User[]
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("roles")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username             String                @unique
  email                String?               @unique
  passwordHash         String
  roleId               String?               @db.Uuid
  role                 Role?                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status               String                @default("active")
  failedLoginAttempts  Int                   @default(0)
  lockoutUntil         DateTime?
  lastLogin            DateTime?
  photo                String? // صورة المستخدم (data URL أو رابط)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  employee             Employee?
  biometricCredentials BiometricCredential[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([lockoutUntil])
  @@index([tenantId])
  @@map("users")
}

model BiometricCredential {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyId        String
  userId       String    @db.Uuid
  user         User?     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  publicKeyDer Bytes
  deviceName   String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@unique([userId, keyId])
  @@index([tenantId])
  @@map("biometric_credentials")
}

model Employee {
  id                        String                @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId                String
  biometricNumber           Int?
  name                      String
  userId                    String?               @unique @db.Uuid
  user                      User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  mobile                    String?
  residence                 String?               @db.VarChar(200)
  nationalId                String?
  dateOfBirth               DateTime?             @db.Date
  gender                    String?
  jobTitle                  String?
  profession                String?
  hourlyRate                Decimal               @db.Decimal(10, 2)
  dailyRate                 Decimal?              @db.Decimal(10, 2)
  baseSalary                Decimal?              @db.Decimal(14, 2)
  livingAllowance           Decimal?              @db.Decimal(14, 2)
  currency                  String                @default("SYP")
  scheduledStart            String?
  scheduledEnd              String?
  employmentStartDate       DateTime?             @db.Date
  terminationDate           DateTime?             @db.Date
  terminationType           String? // resignation | termination
  terminationReason         String?
  terminationNotes          String?
  financialSettlementStatus String                @default("pending") // pending | completed
  financialSettlementDate   DateTime?             @db.Date
  rehireDate                DateTime?             @db.Date
  isSettled                 Boolean               @default(false)
  isFinanciallySettled      Boolean               @default(false)
  department                String                @default("Warehouse")
  departmentId              String?               @db.Uuid
  departmentEntity          Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roleId                    String?               @db.Uuid
  role                      Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status                    String                @default("active")
  workDaysInPeriod          Int                   @default(26)
  hoursPerDay               Int                   @default(8)
  overtimeCalculation       Json?
  gracePeriodMinutes        Int                   @default(5)
  insuranceAmount           Decimal?              @db.Decimal(14, 2)
  transportAllowanceOverride Decimal?             @db.Decimal(14, 2)
  photo                     String? // صورة الموظف (data URL أو رابط)
  attendanceRecords         AttendanceRecord[]
  dailyAttendanceLogs       DailyAttendanceLog[]  @relation("DailyAttendanceLogs")
  advances                  EmployeeAdvance[]
  leaveRequests             LeaveRequest[]
  terminationRecords        TerminationRecord[]
  financialSettlements      FinancialSettlement[]
  rehireRecords             RehireRecord[]
  payrollReceipts           PayrollReceipt[]

  employeeSalary    EmployeeSalary?
  employeeInsurance EmployeeInsurance?
  employeeBonuses   EmployeeBonus[]
  employeePenalties EmployeePenalty[]
  payrollInputs     PayrollInput[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  busPassengers BusPassenger[]

  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@index([status, employeeId])
  @@index([department, status])
  @@index([departmentId])
  @@index([status, createdAt])
  @@index([status, departmentId])
  @@index([departmentId, status])
  @@unique([tenantId, employeeId])
  @@unique([tenantId, biometricNumber])
  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@map("employees")
}

model Department {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  manager       String?
  establishedAt DateTime?
  employees     Employee[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdAt])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

enum LeaveRequestType {
  PAID
  UNPAID
  SICK
  ADMIN
  DEATH
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee?           @relation(fields: [tenantId, employeeId], references: [tenantId, employeeId], onDelete: Cascade)
  leaveType  LeaveRequestType
  status     LeaveRequestStatus @default(PENDING)
  isPaid     Boolean            @default(false)
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  // حقول الإجازة الساعية
  isHourly   Boolean            @default(false)
  startTime  String? // HH:mm — وقت بداية الإجازة الساعية
  endTime    String? // HH:mm — وقت نهاية الإجازة الساعية
  reason     String?
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([employeeId])
  @@index([employeeId, status])
  @@index([leaveType, status])
  @@index([startDate, endDate])
  @@index([tenantId])
  @@map("leave_requests")
}

model Device {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId  String
  name      String
  location  String
  model     String    @default("ZK Teco")
  ip        String?
  port      Int?
  status    String    @default("active")
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([location, status, createdAt])
  @@unique([tenantId, deviceId])
  @@index([tenantId])
  @@map("devices")
}

model AttendanceRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, employeeId], onDelete: Cascade)
  timestamp  DateTime
  type       String
  deviceId   String?
  location   String?
  source     String   @default("device")
  verified   Boolean  @default(false)
  notes      String?
  date       String
  shiftPair  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@index([date, timestamp])
  @@index([employeeId, timestamp])
  @@index([date, employeeId])
  @@index([deviceId, timestamp])
  @@index([employeeId, type, date])
  @@index([employeeId, date, timestamp])
  @@index([date, type])
  @@index([employeeId, date, type])
  // Prevents duplicate punches (same employee + timestamp + type). The migration
  // de-duplicates existing rows (keeping the earliest by createdAt) before this
  // is applied. Application code also guards via a 30-minute re-punch window.
  @@unique([tenantId, employeeId, timestamp, type])
  @@index([tenantId])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Daily Attendance Logs — Event-based logging for audit trail & biometric integration
// ---------------------------------------------------------------------------
enum DailyRecordType {
  ABSENCE // غياب
  DELAY_MINUTES // تأخير بالدقائق
  OVERTIME_MINUTES // إضافي بالدقائق
  PAID_LEAVE // إجازة مدفوعة
  UNPAID_LEAVE // إجازة غير مدفوعة
  SICK_LEAVE // إجازة مرضية
  ADMIN_LEAVE // إجازة إدارية
  DEATH_LEAVE // إجازة وفاة
  EARLY_LEAVE_MINUTES // خروج مبكر بالدقائق
}

model DailyAttendanceLog {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee?        @relation("DailyAttendanceLogs", fields: [tenantId, employeeId], references: [tenantId, employeeId], onDelete: Cascade)
  date       DateTime        @db.Date
  recordType DailyRecordType
  value      Decimal         @db.Decimal(10, 2) // e.g., 1 (for 1 day) or 120 (for 120 minutes)
  notes      String?         @db.Text
  source     String          @default("manual") // manual | biometric | calculated
  createdBy  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([employeeId, date])
  @@index([date])
  @@index([employeeId, recordType, date])
  @@index([recordType, date])
  // Prevents duplicate calculated/manual log rows for the same employee+day+type.
  // Makes aggregateEmployeeDay's deleteMany+create idempotent under concurrency.
  @@unique([tenantId, employeeId, date, recordType, source])
  @@index([tenantId])
  @@map("daily_attendance_logs")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  category     String
  unitPrice    Decimal  @db.Decimal(12, 2)
  costPrice    Decimal  @db.Decimal(12, 2)
  reorderLevel Int      @default(10)
  status       String   @default("active")
  unit         String   @default("قطعة")
  photo        String? // صورة المنتج (data URL أو رابط)

  /// باركود المنتج (EAN13 / Code128) — يُمسح بالجهاز المحمول
  barcode String?

  /// هل يُتتبَّع هذا المنتج بالدفعات وتواريخ الصلاحية؟
  /// حين يكون true تصبح بيانات الدفعة إلزامية عند كل إدخال، ويُطبَّق FEFO عند الإخراج.
  batchTracked Boolean @default(false)
  /// العمر الافتراضي بالأيام — يُشتق منه تاريخ الصلاحية إن لم يُدخَل يدوياً
  shelfLifeDays Int?

  /// أبعاد ووزن الوحدة — يستخدمها محرّك اقتراح التخزين وحساب أوزان الطرود
  weightKg Decimal? @db.Decimal(10, 3)
  volumeM3 Decimal? @db.Decimal(10, 4)

  /// الخانة الافتراضية للتخزين (Fixed slotting)
  defaultBinCode String?
  /// تصنيف ABC حسب معدل الدوران — يقود أولوية الجرد الدوري وقرب الخانة من الشحن
  abcClass String?

  costingMethod CostingMethod @default(WEIGHTED_AVERAGE)

  taxRateId String?  @db.Uuid
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockLevels       StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesOrderItems    SalesOrderItem[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([category, status, createdAt])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, batchTracked])
  @@index([tenantId])
  @@map("products")
}

model StockLevel {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       String
  location  String
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  available Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [tenantId, sku], references: [tenantId, sku], onDelete: Cascade)

  @@unique([tenantId, sku, location])
  @@index([tenantId])
  @@map("stock_levels")
}

model Warehouse {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  status    String    @default("active") // active | inactive
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  zones WarehouseZone[]

  @@index([status])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku           String?
  type          StockMovementType
  quantity      Int // signed delta: +IN / -OUT / +-ADJUSTMENT / +RESERVE / -RELEASE
  location      String
  reason        String?
  referenceType String? // sales_order | purchase_order | manual
  referenceId   String?
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())

  @@index([sku])
  @@index([sku, createdAt])
  @@index([location, createdAt])
  @@index([type, createdAt])
  @@index([createdById])
  @@index([createdAt])
  @@index([tenantId])
  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  status    String   @default("active") // active | inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([name])
  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poNumber     String
  supplierId   String              @db.Uuid
  status       String              @default("draft") // draft | sent | received | cancelled
  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  totalAmount  Decimal             @db.Decimal(12, 2)
  createdBy    String              @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier      Supplier?           @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId  String            @db.Uuid
  sku              String
  quantity         Int
  unitCost         Decimal           @db.Decimal(12, 2)
  receivedQuantity Int               @default(0)

  /// خصم وضريبة على مستوى البند — تُرحَّل إلى فاتورة الشراء عند إنشائها من الأمر
  discountPercent Decimal @default(0) @db.Decimal(6, 3)
  taxRate         Decimal @default(0) @db.Decimal(6, 3)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  purchaseOrder    PurchaseOrder?    @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  product          Product?           @relation(fields: [tenantId, sku], references: [tenantId, sku], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([purchaseOrderId])
  @@index([sku])
  @@index([tenantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptNumber   String
  purchaseOrderId String              @db.Uuid
  receivedBy      String              @db.Uuid
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  purchaseOrder   PurchaseOrder?      @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  items           GoodsReceiptItem[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([purchaseOrderId])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goodsReceiptId      String            @db.Uuid
  purchaseOrderItemId String            @db.Uuid
  sku                 String
  quantity            Int
  location            String
  unitCost            Decimal           @db.Decimal(12, 2)

  /// بيانات الدفعة الملتقطة عند الاستلام — تُنشئ ProductBatch مباشرة
  batchId        String?   @db.Uuid
  batchNumber    String?
  productionDate DateTime? @db.Date
  expiryDate     DateTime? @db.Date

  /// فحص الجودة: البضاعة تدخل الحجر حتى تُعتمد حين يكون الفحص مطلوباً
  qcStatus  QcStatus  @default(PASSED)
  qcNotes   String?
  qcBy      String?   @db.Uuid
  qcAt      DateTime?

  createdAt           DateTime          @default(now())

  goodsReceipt        GoodsReceipt?     @relation(fields: [tenantId, goodsReceiptId], references: [tenantId, id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [tenantId, purchaseOrderItemId], references: [tenantId, id], onDelete: Restrict)
  product             Product?           @relation(fields: [tenantId, sku], references: [tenantId, sku], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([sku])
  @@index([tenantId])
  @@map("goods_receipt_items")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  status    String   @default("active") // active | inactive

  /// فئة التسعير المطبَّقة على هذا العميل (جملة / مفرق / خاص)
  priceTierId String?    @db.Uuid
  priceTier   PriceTier? @relation(fields: [priceTierId], references: [id], onDelete: SetNull)

  /// سقف الائتمان — يمنع ترحيل فاتورة تتجاوزه
  creditLimit Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([name])
  @@index([tenantId])
  @@map("customers")
}

model SalesOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  soNumber     String
  customerId   String              @db.Uuid
  status       String              @default("draft") // draft | confirmed | delivered | cancelled
  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  totalAmount  Decimal             @db.Decimal(12, 2)
  paidAmount   Decimal             @default(0) @db.Decimal(12, 2)

  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([supplierId])

enum DailyRecordType {
  ABSENCE // ØºÙŠØ§Ø¨
  DELAY_MINUTES // ØªØ£Ø®ÙŠØ± Ø¨Ø§Ù„Ø¯Ù‚Ø§Ø¦Ù‚
  OVERTIME_MINUTES // Ø¥Ø¶Ø§ÙÙŠ Ø¨Ø§Ù„Ø¯Ù‚Ø§Ø¦Ù‚
  PAID_LEAVE // Ø¥Ø¬Ø§Ø²Ø© Ù…Ø¯ÙÙˆØ¹Ø©

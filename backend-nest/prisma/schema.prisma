// ---------------------------------------------------------------------------
// Transportation — إدارة الباصات والنقل
// ---------------------------------------------------------------------------
model Bus {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  busId                String // كود الباص
  route                String // الخط / مسار الرحلة
  plateNumber          String // رقم اللوحة
  driverName           String // اسم السائق
  driverPhone          String // رقم السائق (10 أرقام سورية)
  totalCost            Decimal        @db.Decimal(14, 2) // التكلفة الإجمالية (ل.س)
  companyDeductionPct  Decimal        @db.Decimal(5, 2) // حسم الشركة بالنسبة المئوية
  capacity             Int // سعة الركاب
  // نسبة خصم أجرة النقل التي تُحسم من راتب الموظف (نسبة 0-100)
  employeeDeductionPct Decimal        @default(0) @db.Decimal(5, 2)
  status               String         @default("active") // active | inactive
  passengers           BusPassenger[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([status])
  @@index([route, status])
  @@unique([tenantId, busId])
  @@unique([tenantId, plateNumber])
  @@index([tenantId])
  @@map("buses")
}

model BusPassenger {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  busId            String    @db.Uuid
  bus              Bus?      @relation(fields: [tenantId, busId], references: [tenantId, id], onDelete: Cascade)
  employeeId       String
  employee         Employee?  @relation(fields: [tenantId, employeeId], references: [tenantId, employeeId], onDelete: Cascade)
  name             String? // optional passenger name for display
  subscriptionDate DateTime  @default(now()) @db.Date
  terminationDate  DateTime? @db.Date // تاريخ انتهاء الاشتراك (عند الاستقالة/الإيقاف)
  status           String    @default("active") // active | inactive
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, busId, employeeId])
  @@index([employeeId])
  @@index([busId, status])
  @@index([tenantId])
  @@map("bus_passengers")
}

// =============================================================================
// Audit Log — سجل التدقيق الكامل لكل العمليات الحساسة
// =============================================================================
model AuditLog {
  id String @id @default(cuid())
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// من نفّذ العملية (userId)
  actorId String?

  /// اسم المستخدم المنفِّذ
  actorUsername String?

  /// نوع العملية: user.create | employee.update | payroll.run | auth.login ...
  action String

  /// نوع الكيان المتأثر: employee | user | payroll | attendance ...
  targetType String?

  /// معرّف الكيان المتأثر
  targetId String?

  /// عنوان الـ IP
  ipAddress String?

  /// User Agent (المتصفح أو التطبيق)
  userAgent String?

  /// بيانات إضافية (JSON حر)
  metadata Json?

  createdAt DateTime @default(now())

  /// فهرس للبحث بالمستخدم والتاريخ
  @@index([actorId, createdAt])
  @@index([targetType, createdAt])
  @@index([targetId])
  @@index([action, createdAt])
  @@index([tenantId])
  @@map("audit_logs")
}

enum NotificationType {
  CHECK_IN
  CHECK_OUT
  BONUS
  PENALTY
  ADVANCE
  LEAVE
  TERMINATION
  RESIGNATION
  LATE
  ABSENT
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  DANGER
}

model Notification {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         NotificationType
  severity     NotificationSeverity @default(INFO)

  /// عنوان الإشعار (بالعربية)
  title        String
  /// نص الإشعار (بالعربية)
  message      String

  /// الموظف المرتبط بالحدث (إن وجد)
  employeeId   String?
  employeeName String?

  /// نوع الكيان المصدر: bonus | penalty | advance | leave | attendance | employee
  entityType   String?
  /// معرّف السجل المصدر
  entityId     String?

  /// بيانات إضافية حرة (JSON)
  metadata     Json?

  /// مفتاح إلغاء التكرار (يستخدمه تنبيه الغياب لمنع التكرار في نفس اليوم)
  dedupeKey    String?

  isRead       Boolean              @default(false)
  readAt       DateTime?

  /// تجاهل نهائي (زر "تجاهل" لتنبيهات الغياب/التأخير)
  isDismissed  Boolean              @default(false)
  dismissedAt  DateTime?
  dismissedBy  String?

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isRead, createdAt])
  @@index([isDismissed, type])
  @@index([type, createdAt])
  @@index([employeeId])
  @@unique([tenantId, dedupeKey])
  @@index([tenantId])
  @@map("notifications")
}

  updatedAt   DateTime        @updatedAt

  parent      Account?        @relation("AccountTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children    Account[]       @relation("AccountTree")
  journalLines JournalEntryLine[]
  mappings    AccountMapping[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([type])
  @@index([parentId])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {

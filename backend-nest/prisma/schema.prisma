model RehireRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, employeeId], onDelete: Cascade)
  rehireDate            DateTime @db.Date
  processedBy           String
  previousTerminationId String?  @db.Uuid
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  previousTermination TerminationRecord? @relation("TerminationToRehire", fields: [previousTerminationId], references: [id], onDelete: SetNull)


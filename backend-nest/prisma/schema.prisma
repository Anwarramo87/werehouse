/**
 * Which pages a factory has been sold.
 *
 * One row per factory rather than one row per page: this is read on every
 * gated request, so a single indexed lookup that can be cached whole beats a
 * join returning dozens of rows. Modules are not stored -- they are a bundle
 * operation over these page keys, so there is never a "module on, page off"
 * contradiction to resolve. See src/common/entitlements/catalogue.ts.
 */
model TenantEntitlement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Page keys from the catalogue. Absent key = not entitled.
  enabledPages String[] @default([])

  /// Who last changed this, for the audit trail the Super Admin UI writes.
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_entitlements")
}

/**
 * Which pages one admin account of a factory may actually use.
 *
 * One row per admin (userId unique). Effective access = factory pages that the
 * USER also holds: store pages here, and if a key is absent the factory-level
 * grant still bites as the ceiling. A factory without per-user rows behaves
 * exactly as before (every admin inherits the whole factory grant), so existing
 * factories keep working with zero migration work on their side.
 */
model UserEntitlement {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabledPages String[] @default([])
  updatedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_entitlements")
}

/**
 * Time-boxed subscription of one factory: plan + window.
 *
 * Enforcement lives in EntitlementsService.effectiveFactoryPages: while a row
 * exists and now is past endsAt, the factory holds NOTHING â€” sidebar modules
 * vanish and the API 403s, leaving only the always-available routes. A
 * factory with NO row keeps the legacy behaviour (fully entitled), so this
 * migration takes nothing away from existing factories: nothing changes until
 * the Super Admin actually sets a subscription.
 */
model TenantSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// monthly | yearly | custom
  plan     String
  startsAt DateTime
  endsAt   DateTime

  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endsAt])
  @@map("tenant_subscriptions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  permissions String[]   @default([])
  users       User[]
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("roles")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String?               @db.Uuid
  tenant               Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username             String                @unique
  email                String?               @unique
  passwordHash         String
  roleId               String?               @db.Uuid
  role                 Role?                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status               String                @default("active")
  failedLoginAttempts  Int                   @default(0)
  lockoutUntil         DateTime?
  lastLogin            DateTime?
  photo                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  employee             Employee?
  biometricCredentials BiometricCredential[]
  entitlement          UserEntitlement? // per-admin pages this account may use
  subscription         UserSubscription? // per-admin time window (this account alone)


  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([lockoutUntil])
  @@index([tenantId])
  @@map("users")
}

model BiometricCredential {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyId        String
  userId       String    @db.Uuid
  user         User?     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  publicKeyDer Bytes
  deviceName   String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@unique([userId, keyId])
  @@index([tenantId])
  @@map("biometric_credentials")
}


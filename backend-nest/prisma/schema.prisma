  items       SalesOrderItem[]
  payments    SalesPayment[]
  invoices    SalesInvoice[]

  // Referenced by tenant-composite foreign keys: Postgres requires the

  // referenced columns to carry a unique constraint.

  @@unique([tenantId, id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@unique([tenantId, soNumber])
  @@index([tenantId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
